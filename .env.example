# ==========================================
# TradeRule AI - Environment Configuration
# ==========================================

# --- Backend Application Settings ---
PORT=8000
ENVIRONMENT=production
ALLOWED_ORIGINS=http://localhost:3000,https://traderule-ai.vercel.app

# --- Database & Persistent Storage ---
# For local development SQLite: sqlite:///data/traderule.db
# For production PostgreSQL: postgresql://username:password@hostname:5432/traderuledb
DATABASE_URL=sqlite:///data/traderule.db

# --- Authentication & Session Security ---
# Secret key for signing HS256 JWT session tokens (generate using: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# --- Administrator Bootstrap (Optional for automated deploy) ---
ADMIN_BOOTSTRAP_EMAIL=admin@traderule.ai
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=TradeRule Administrator

# --- AI & Large Language Model (Google Gemini) ---
GEMINI_API_KEY=your_gemini_api_key_here
CHAT_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Vector Database (Qdrant Cloud / Local) ---
# For Qdrant Cloud: https://xxxx.cloud.qdrant.io:6333
# For local fallback: leave empty or local URL (system falls back to data/embedding_store.json)
QDRANT_URL=https://your-cluster-id.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
COLLECTION_NAME=traderule_rag_chunks

# --- Document Ingestion & RAG Settings ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
UPLOAD_CHUNK_SIZE=100
UPLOAD_CHUNK_OVERLAP=15
EMBEDDING_BATCH_SIZE=2
RAG_LOG_DIR=logs
CACHE_TTL_SECONDS=900

# --- Frontend Next.js Configuration ---
# Public backend API URL consumed by the client browser
NEXT_PUBLIC_RAG_API_URL=http://127.0.0.1:8000
# Internal backend URL consumed by Next.js server-side route handlers (/api/chat, /api/health)
API_BASE_URL=http://127.0.0.1:8000

